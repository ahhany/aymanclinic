# --- Production API (server/standalone.ts) ---
# Supabase Postgres connection string (Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Comma-separated frontend origins allowed to call the API
CORS_ORIGIN=https://aymanclinic.vercel.app,https://your-project.lovable.app
# Port the API listens on (hosting platforms inject their own PORT)
PORT=8080

# --- Frontend build (Vite) ---
# Where the published frontend finds the API (empty = same-origin dev)
VITE_API_BASE_URL=https://aymanclinic-api.onrender.com
